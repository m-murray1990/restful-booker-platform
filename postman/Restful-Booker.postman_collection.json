    {
      "name": "/booking/:id - UpdateBooking (JSON)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let response;",
              "try {",
              "    response = pm.response.json();",
              "} catch (e) {",
              "    console.error(\"Response is not valid JSON:\", pm.response.text());",
              "}",
              "",
              "pm.test(\"Response body is not empty\", function () {",
              "    pm.expect(response).to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Firstname updated successfully\", function () {",
              "    pm.expect(response.booking.firstname).to.eql(\"Melissa\");",
              "});",
              "",
              "pm.test(\"Lastname updated successfully\", function () {",
              "    pm.expect(response.booking.lastname).to.eql(\"Bull\");",
              "});",
              "",
              "pm.test(\"Deposit paid value updated successfully\", function () {",
              "    pm.expect(response.booking.depositpaid).to.eql(true);",
              "});",
              "",
              "pm.test(\"Check-in date updated successfully\", function () {",
              "    pm.expect(response.booking.bookingdates.checkin).to.eql(\"2026-08-01\");",
              "});",
              "",
              "pm.test(\"Check-out date updated successfully\", function () {",
              "    pm.expect(response.booking.bookingdates.checkout).to.eql(\"2026-08-10\");",
              "});",
              "",
              "pm.test(\"Response time is less than 2 seconds\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"authToken was set by pre-request script\", function () {",
              "    const authToken = pm.environment.get(\"authToken\");",
              "    pm.expect(authToken, \"authToken environment variable should exist\").to.not.be.undefined;",
              "    pm.expect(authToken, \"authToken should not be empty\").to.not.be.empty;",
              "    pm.expect(authToken, \"authToken should be a string\").to.be.a(\"string\");",
              "});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const authHostUrl = pm.variables.replaceIn(\"{{authHost}}\");",
              "",
              "pm.sendRequest({",
              "    url: authHostUrl + \"/auth/login\",",
              "    method: \"POST\",",
              "    header: {",
              "        \"Content-Type\": \"application/json\"",
              "    },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({ username: \"admin\", password: \"password\" })",
              "    }",
              "}, function (err, res) {",
              "    if (err) {",
              "        console.error(\"Auth request failed:\", err);",
              "    } else {",
              "        const setCookieHeader = res.headers.get('set-cookie');",
              "        const token = setCookieHeader ? setCookieHeader.match(/token=([^;]+)/)[1] : null;",
              "        pm.environment.set(\"authToken\", token);",
              "        console.log(\"Token set:\", token);",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
