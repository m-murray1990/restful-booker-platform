        {
          "name": "CheckAvailabilityInvalidDate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{roomHost}}/room/?checkin=invalid&checkout=invalid",
              "host": [
                "{{roomHost}}"
              ],
              "path": [
                "room",
                ""
              ],
              "query": [
                {
                  "key": "checkin",
                  "value": "invalid"
                },
                {
                  "key": "checkout",
                  "value": "invalid"
                }
              ]
            },
            "description": "Attempts to check room availability with invalid date strings. Expects a 500 error response from the room service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 500', function () {",
                  "    pm.response.to.have.status(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "CheckAvailabilityCorrectDate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{roomHost}}/room/?checkin=2026-07-01&checkout=2026-07-07",
              "host": [
                "{{roomHost}}"
              ],
              "path": [
                "room",
                ""
              ],
              "query": [
                {
                  "key": "checkin",
                  "value": "2026-07-01"
                },
                {
                  "key": "checkout",
                  "value": "2026-07-07"
                }
              ]
            },
            "description": "Checks room availability with valid check-in and check-out dates. Expects a 200 response containing an array of rooms."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains rooms array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('rooms');",
                  "    pm.expect(jsonData.rooms).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ],
      "description": "The purpose of these tests are to test the new functionality which enables useres to search and view availability from the landing screen without having to go through the booking process to see which rooms are available on a selected date"
    },
